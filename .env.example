## Variables usadas por la app

# Solo si en tu red falla la verificación SSL (entornos corporativos/proxy)
# SCRAPGD_INSECURE_SSL=1

# Hacer también la petición a la página VIP desde index.js
# GET_VIP_PAGE_LINKS=1

# Headers extra para el scraper (axios, peliculasgd.net). Se mezclan con los por defecto.
# SCRAPGD_HEADERS_JSON={"Cookie":"nombre=valor; otro=valor"}
# SCRAPGD_HEADERS_FILE=./scraper-headers.json

# User-Agent y cookie por defecto para las peticiones VIP (vip-browser.js)
# VIP_USER_AGENT=Mozilla/5.0 ...
# VIP_COOKIE=cf_clearance=xxx; otra=yyy

# Opcional: variables de entorno para URLs, API keys, etc.
# BASE_URL=https://example.com

# Solo si en tu red falla la verificación SSL (entornos corporativos/proxy):
# SCRAPGD_INSECURE_SSL=1

# Enlace VIP: abrir en navegador (Playwright) y extraer enlaces tras verificación de bot
# GET_VIP_PAGE_LINKS=1

# Login en la página VIP (k5book.info etc.). Si la URL te manda a login, rellena esto.
# VIP_USER=tu_usuario
# VIP_PASSWORD=tu_clave
# (También se puede usar VIP_EMAIL en lugar de VIP_USER)

# --- Headers y cookies (navegador VIP y scraper) ---
# Headers extra para el navegador VIP (Playwright). JSON o ruta a archivo .json
 VIP_HEADERS_JSON={"coockie":"muser=17106; msession=71f6877bbae47590796d229ef3dcb456; cf_clearance=PW1kJM.HldeMGl.crNoqQuwE5sYCpbqQU8IktarzKlM-1773115943-1.2.1.1-IDBo992saWjTwKcYK4WYlu1KzWb5bhERZB..L38xsmN80c7zcxrZFsaeyIrR4Fct2IkpY7eGrsIwytEh1Pk8v7qfYvlE_BrHkrXeuo1X81HdzQ5JpR52WGLBXTtRnwxG.KWnZiKwK41GoaHZ6az8OroC_N4ChkYcQRTA9l8Vuii1mtQ_cMHvkto0N09EjyFX4YDYPdLJQh5AoOtqkBUZrPredoWvxtu7xd3D9Y30TLI"}
# VIP_HEADERS_FILE=./vip-headers.json

# Cookies extra para el navegador VIP. JSON: array de { name, value, domain, path? }
# VIP_COOKIES_FILE=./vip-cookies.json

# Headers extra para el scraper (axios, peliculasgd.net). Se mezclan con los por defecto. Cookie va aquí si lo necesitas.
# SCRAPGD_HEADERS_JSON={"Cookie":"nombre=valor; otro=valor"}
# SCRAPGD_HEADERS_FILE=./scraper-headers.json

# Navegador visible (para resolver captcha manualmente). Por defecto headless.
# HEADLESS=0

# Usar tu Chrome real para resolver el captcha ahí:
# 1. Cierra Chrome. Ábrelo con depuración remota:
#    Windows: "C:\Program Files\Google\Chrome\Application\chrome.exe" --remote-debugging-port=9222
#    Mac:     /Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome --remote-debugging-port=9222
# 2. Ejecuta: CHROME_DEBUG_PORT=9222 node src/vip-browser.js https://k5book.info/?v=XXXXX
# Se abrirá una pestaña en tu Chrome; resuelves el captcha y el script extrae los enlaces.
# CHROME_DEBUG_PORT=9222

# Milisegundos de espera para que cargue la página (Cloudflare + enlaces). Aumenta si tarda mucho.
# Por defecto: 20000 headless, 60000 visible. Ejemplo para 2 minutos: 120000
# VIP_WAIT_MS=60000
